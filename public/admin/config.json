{
  "backend": {
    "name": "github",
    "repo": "hwslim/hwslim.github.io",
    "branch": "main",
    "base_url": "",
    "auth_endpoint": "auth"
  },
  "site_url": "https://erilab.xyz",
  "display_url": "https://erilab.xyz",
  "logo_url": "/assets/brand/erilab-logo-v2.png",
  "locale": "ko",
  "media_folder": "public/uploads",
  "public_folder": "/uploads",
  "editor": {
    "preview": false
  },
  "collections": [
    {
      "name": "settings",
      "label": "홈페이지 설정",
      "files": [
        {
          "name": "site",
          "label": "사이트 정보",
          "file": "content/settings/site.json",
          "fields": [
            {
              "name": "lab_name",
              "label": "연구실 표기",
              "widget": "string",
              "required": true,
              "default": "ERILab"
            },
            {
              "name": "full_name",
              "label": "정식 영문 이름",
              "widget": "string",
              "required": true,
              "default": "Embodied Robot Intelligence Lab"
            },
            {
              "name": "affiliation",
              "label": "소속",
              "widget": "string",
              "required": false,
              "default": "KIST · Center for AI Research"
            },
            {
              "name": "logo",
              "label": "로고",
              "widget": "image",
              "required": false,
              "default": "/assets/brand/erilab-logo-v2.png",
              "media_library": {
                "config": {
                  "max_file_size": 10485760,
                  "multiple": false
                }
              },
              "media_extensions": [
                "jpg",
                "jpeg",
                "png",
                "webp"
              ]
            },
            {
              "name": "kist_logo",
              "label": "KIST 로고",
              "widget": "image",
              "required": false,
              "default": "/assets/brand/kist-logo.png",
              "media_library": {
                "config": {
                  "max_file_size": 10485760,
                  "multiple": false
                }
              },
              "media_extensions": [
                "jpg",
                "jpeg",
                "png",
                "webp"
              ]
            },
            {
              "name": "meta_description",
              "label": "검색 결과 소개",
              "widget": "text",
              "required": false,
              "default": "Vision-based robot intelligence and loco-manipulation research at KIST."
            },
            {
              "name": "footer_text",
              "label": "하단 소개 문구",
              "widget": "text",
              "required": false,
              "default": "Vision-based intelligence for robots that move and interact with the world."
            },
            {
              "name": "nav_home",
              "label": "Home 메뉴 이름",
              "widget": "string",
              "required": false,
              "default": "Home"
            },
            {
              "name": "nav_research",
              "label": "Research 메뉴 이름",
              "widget": "string",
              "required": false,
              "default": "Research"
            },
            {
              "name": "nav_people",
              "label": "People 메뉴 이름",
              "widget": "string",
              "required": false,
              "default": "People"
            },
            {
              "name": "nav_publications",
              "label": "Publications 메뉴 이름",
              "widget": "string",
              "required": false,
              "default": "Publications"
            },
            {
              "name": "nav_news",
              "label": "News 메뉴 이름",
              "widget": "string",
              "required": false,
              "default": "News"
            },
            {
              "name": "nav_gallery",
              "label": "Gallery 메뉴 이름",
              "widget": "string",
              "required": false,
              "default": "Gallery"
            },
            {
              "name": "nav_contact",
              "label": "Contact 메뉴 이름",
              "widget": "string",
              "required": false,
              "default": "Contact"
            }
          ]
        },
        {
          "name": "home",
          "label": "첫 페이지",
          "file": "content/settings/home.json",
          "fields": [
            {
              "name": "hero_eyebrow",
              "label": "첫 화면 상단 문구",
              "widget": "string",
              "required": false,
              "default": "EMBODIED ROBOT INTELLIGENCE LAB"
            },
            {
              "name": "hero_title",
              "label": "첫 화면 제목",
              "widget": "text",
              "required": false,
              "default": "Vision for embodied\nrobot intelligence."
            },
            {
              "name": "hero_description",
              "label": "첫 화면 소개",
              "widget": "text",
              "required": false,
              "default": "We study vision-based robot intelligence at KIST, with a focus on loco-manipulation: bringing robot movement and object interaction together."
            },
            {
              "name": "hero_image",
              "label": "첫 화면 대표 이미지",
              "widget": "image",
              "required": false,
              "default": "",
