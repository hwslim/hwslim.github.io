              "default": "We investigate vision-based robot intelligence and loco-manipulation."
            },
            {
              "name": "people_title",
              "label": "구성원 페이지 제목",
              "widget": "string",
              "required": false,
              "default": "Our people"
            },
            {
              "name": "people_intro",
              "label": "구성원 페이지 소개",
              "widget": "text",
              "required": false,
              "default": "The researchers behind ERILab at KIST."
            },
            {
              "name": "publications_title",
