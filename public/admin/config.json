              "required": false,
              "default": "Connecting visual perception with robot action."
            },
            {
              "name": "research_button",
              "label": "연구 소개 버튼",
              "widget": "string",
              "required": false,
              "default": "Explore our research"
            },
            {
              "name": "people_button",
              "label": "구성원 소개 버튼",
              "widget": "string",
              "required": false,
              "default": "Meet the team"
            },
            {
              "name": "home_research_title",
              "label": "연구 영역 제목",
              "widget": "string",
              "required": false,
              "default": "From perception to action"
            },
            {
              "name": "home_research_intro",
              "label": "연구 영역 소개",
              "widget": "text",
              "required": false,
              "default": "Our research connects how robots see with how they move and interact."
            },
            {
              "name": "home_news_title",
              "label": "최신 소식 영역 제목",
              "widget": "string",
              "required": false,
              "default": "Latest News"
            },
            {
              "name": "home_publications_title",
              "label": "최신 논문 영역 제목",
              "widget": "string",
              "required": false,
              "default": "Selected publications"
            },
            {
              "name": "view_all_label",
              "label": "전체 보기 링크",
              "widget": "string",
              "required": false,
              "default": "View all"
            }
          ]
        },
        {
          "name": "pages",
          "label": "페이지 제목·소개",
          "file": "content/settings/pages.json",
          "fields": [
            {
              "name": "research_title",
              "label": "연구 페이지 제목",
              "widget": "string",
              "required": false,
              "default": "Research"
