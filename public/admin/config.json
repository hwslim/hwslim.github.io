              "required": false,
              "default": "Photos from our lab will appear here."
            },
            {
              "name": "research_empty",
              "label": "연구 항목이 없을 때 안내",
              "widget": "text",
              "required": false,
              "default": "Research areas will be listed here."
            },
            {
              "name": "people_empty",
              "label": "구성원이 없을 때 안내",
              "widget": "text",
              "required": false,
              "default": "Our team will be introduced here."
