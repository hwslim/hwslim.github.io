    {
      "name": "people",
      "label": "구성원",
      "folder": "content/people",
      "create": true,
      "delete": true,
      "format": "json",
      "extension": "json",
      "identifier_field": "name",
      "slug": "{{year}}-{{month}}-{{day}}-{{slug}}",
      "summary": "{{name}}",
      "fields": [
        {
          "name": "id",
          "label": "ID",
          "widget": "hidden",
          "default": "",
          "required": false
        },
        {
          "name": "group",
          "label": "구성원 구분",
          "widget": "erilab-options",
          "required": true,
          "default": "Researchers",
          "options": [
            {
              "value": "Principal Investigator",
              "label": "PI"
            },
            {
              "value": "Researchers",
              "label": "연구원"
            },
            {
              "value": "Interns",
              "label": "Intern"
            },
            {
              "value": "Students",
              "label": "학생"
            },
            {
              "value": "Alumni",
              "label": "Alumni로 이동"
            }
          ],
          "hint": "현 구성원을 Alumni로 이동하려면 Alumni를 선택하고 이동한 기관을 입력하세요. 사진·이메일·CV 등은 저장할 때 제거됩니다."
        },
        {
          "name": "name",
          "label": "영문 이름",
          "widget": "string",
          "required": true
        },
        {
          "name": "name_ko",
          "label": "한글 이름",
          "widget": "string",
          "required": false
        },
        {
          "name": "education",
          "label": "학위·과정",
          "widget": "erilab-options",
          "required": false,
          "default": "",
          "options": [
            {
              "value": "",
              "label": "미지정"
            },
            {
              "value": "Ph.D.",
              "label": "박사 (Ph.D.)"
            },
            {
              "value": "M.S.",
              "label": "석사 (M.S.)"
            },
            {
              "value": "B.S.",
              "label": "학사 (B.S.)"
            },
            {
              "value": "Ph.D. Student",
              "label": "박사과정 학생"
            },
            {
              "value": "M.S. Student",
              "label": "석사과정 학생"
            },
            {
              "value": "Undergraduate Student",
              "label": "학부생"
            }
          ]
        },
        {
          "name": "role",
          "label": "직함",
          "widget": "erilab-options",
          "required": false,
          "default": "Researcher",
          "options": [
            {
              "value": "",
              "label": "해당 없음 (Interns·Students·Alumni)"
            },
            {
              "value": "Head, Principal Researcher",
              "label": "연구단장·책임연구원"
            },
            {
              "value": "Principal Researcher",
              "label": "책임연구원"
            },
            {
              "value": "Senior Researcher",
              "label": "선임연구원"
            },
            {
              "value": "Postdoctoral Researcher",
              "label": "포닥"
            },
            {
              "value": "Researcher",
              "label": "연구원"
            }
          ]
        },
        {
          "name": "special_service",
          "label": "전문연구요원으로 근무",
          "widget": "boolean",
          "required": false,
          "default": false
        },
        {
          "name": "school",
          "label": "학교 이름",
          "widget": "string",
          "required": false
        },
        {
          "name": "bio",
          "label": "소개",
          "widget": "text",
          "required": false
        },
        {
          "name": "image",
          "label": "프로필 사진",
          "widget": "image",
          "required": false,
          "media_library": {
            "config": {
              "max_file_size": 10485760,
              "multiple": false
            },
            "allow_multiple": false
          },
          "media_extensions": [
            "jpg",
            "jpeg",
            "png",
            "webp"
          ]
        },
        {
          "name": "link",
          "label": "개인 홈페이지",
          "widget": "string",
          "required": false
        },
        {
          "name": "email",
          "label": "공개 이메일",
          "widget": "string",
          "required": false
        },
        {
          "name": "cv_url",
          "label": "CV 웹 링크",
          "widget": "string",
          "required": false,
          "hint": "본인의 CV 웹 주소를 선택 사항으로 등록합니다."
        },
        {
          "name": "cv_file",
          "label": "CV PDF 파일",
          "widget": "file",
          "required": false,
          "media_library": {
            "config": {
              "max_file_size": 10485760,
              "multiple": false
            },
            "allow_multiple": false
          },
          "media_extensions": [
            "pdf"
          ]
        },
        {
          "name": "destination",
          "label": "이동한 기관·진로",
          "widget": "string",
          "required": false,
          "hint": "Alumni로 이동할 때 이동한 기관·진로를 입력하세요. 저장하면 사진·이메일·CV 등 현 구성원 정보를 제거합니다."
        },
        {
          "name": "position",
          "label": "표시 순서 (작은 숫자부터, Researchers는 같은 직급 내)",
          "widget": "number",
          "required": true,
          "default": 0,
          "value_type": "int",
          "min": 0,
          "max": 9999
        }
      ]
    },
